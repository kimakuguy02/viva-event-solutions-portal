rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function hasVerifiedEmail() {
      return request.auth != null &&
        request.auth.token.email_verified == true;
    }

    function isOwner(ownerId) {
      return request.auth != null &&
        request.auth.uid == ownerId;
    }

    function isPlatformAdmin() {
      return hasVerifiedEmail() &&
        request.auth.token.email in [
          'misterk1502@gmail.com',
          'direction.generale@viva-eventsolutions.cd'
        ];
    }

    function isContentManager() {
      return hasVerifiedEmail() &&
        request.auth.token.email in [
          'misterk1502@gmail.com',
          'direction.generale@viva-eventsolutions.cd',
          'malthus.kilumba@viva-eventsolutions.cd',
          'admin.malthus@viva-eventsolutions.cd',
          'commercial@viva-eventsolutions.cd'
        ];
    }

    function isFinanceStaff() {
      return hasVerifiedEmail() &&
        request.auth.token.email in [
          'misterk1502@gmail.com',
          'direction.generale@viva-eventsolutions.cd',
          'malthus.kilumba@viva-eventsolutions.cd',
          'comptable@viva-eventsolutions.cd'
        ];
    }

    function isAllowedImageOrVideo(maxMb) {
      return request.resource != null &&
        request.resource.size <= maxMb * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/(jpeg|png|webp|gif)') ||
          request.resource.contentType.matches('video/(mp4|webm|quicktime)')
        );
    }

    function isAllowedDocument(maxMb) {
      return request.resource != null &&
        request.resource.size <= maxMb * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/(jpeg|png|webp|gif)') ||
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'application/msword' ||
          request.resource.contentType.matches('application/vnd.openxmlformats-officedocument\\..*')
        );
    }

    // Les médias et le CMS sont publics en lecture ; seuls les comptes métier
    // vérifiés et explicitement autorisés peuvent les modifier.
    match /media/{allPaths=**} {
      allow read: if true;
      allow create, update: if isContentManager() && isAllowedImageOrVideo(50);
      allow delete: if isContentManager();
    }

    match /cms/{allPaths=**} {
      allow read: if true;
      allow create, update: if isContentManager() &&
        request.resource != null &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isContentManager();
    }

    // Dossiers privés : l'identifiant du propriétaire fait partie du chemin.
    // Le personnel financier peut traiter les pièces justificatives des devis.
    match /quotes/{ownerId}/{allPaths=**} {
      allow read: if isOwner(ownerId) || isFinanceStaff();
      allow create, update: if (isOwner(ownerId) || isFinanceStaff()) &&
        isAllowedDocument(25);
      allow delete: if isOwner(ownerId) || isFinanceStaff();
    }

    match /erp/{ownerId}/{allPaths=**} {
      allow read: if isFinanceStaff();
      allow create, update: if isFinanceStaff() && isAllowedDocument(20);
      allow delete: if isFinanceStaff();
    }

    match /signatures/{ownerId}/{allPaths=**} {
      allow read: if isFinanceStaff();
      allow create, update: if isFinanceStaff() &&
        request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isFinanceStaff();
    }

    match /documents/{ownerId}/{allPaths=**} {
      allow read: if isOwner(ownerId) || isPlatformAdmin();
      allow create, update: if (isOwner(ownerId) || isPlatformAdmin()) &&
        isAllowedDocument(30);
      allow delete: if isOwner(ownerId) || isPlatformAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
